# Backend application settings
APP_NAME=
APP_VERSION=
DEBUG=false

# Backend runtime limits (non-sensitive defaults verified by repository checks)
DAILY_EXP_CAP=300
ANTI_FARMING_INTERVAL_MINUTES=10

# Backend database connection settings — set locally; never commit credentials
SQLALCHEMY_DATABASE_URL=
DATABASE_URL=
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# PostgreSQL container initialization settings — set locally; never commit credentials
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Flutter compile-time launch setting (pass with --dart-define; not loaded from .env)
API_BASE_URL=

# Optional official nutrition lookup keys — values stay local/Render only
RDA_NUTRITION_API_KEY=
MFDS_FOOD_API_KEY=
USDA_FDC_API_KEY=

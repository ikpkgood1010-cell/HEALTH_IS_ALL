# ============================================================
# HEALTH IS ALL - Flutter Web 프론트엔드 빌드 + nginx 서빙
# ============================================================
# 사용법 (프로젝트 루트에서 실행):
#   docker build -f deploy/Dockerfile.web -t health-is-all-web .
#   docker run -p 8080:80 health-is-all-web
#
# 이 이미지는 프론트엔드(정적 파일)만 서빙한다. 백엔드(FastAPI)는
# 기존 루트 Dockerfile/docker-compose.yml로 별도 실행해야 하며,
# deploy/nginx.conf가 /api 요청을 백엔드로 프록시한다.
# 함께 실행하려면 deploy/docker-compose.web.yml을 사용하라.
# ============================================================

# ---- Stage 1: Flutter Web 빌드 ----
FROM debian:bookworm-slim AS build

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl git unzip xz-utils ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Flutter SDK 설치 (stable 채널)
RUN git clone https://github.com/flutter/flutter.git -b stable /flutter
ENV PATH="/flutter/bin:${PATH}"
RUN flutter precache --web && flutter doctor -v

WORKDIR /app
COPY pubspec.yaml pubspec.lock* ./
RUN flutter pub get

COPY . .

# API_BASE_URL을 빌드 시점에 오버라이드하고 싶다면:
#   docker build --build-arg API_BASE_URL=https://api.example.com ...
ARG API_BASE_URL=""
RUN if [ -n "$API_BASE_URL" ]; then \
      flutter build web --release --dart-define=API_BASE_URL=$API_BASE_URL; \
    else \
      flutter build web --release; \
    fi

# ---- Stage 2: nginx로 정적 파일 서빙 ----
FROM nginx:1.27-alpine

COPY --from=build /app/build/web /usr/share/nginx/html
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
